# ProviderMap reads exactly one environment variable. Copy this file to .env
# (gitignored) if you use a tool like python-dotenv or direnv to load it, or
# just export it in your shell - ProviderMap reads os.environ directly and
# has no python-dotenv dependency of its own.

# Overrides politeness.user_agent's contact address in config.yaml, so your
# personal email never has to be the value committed to a public fork.
PROVIDERMAP_CONTACT_EMAIL=you@example.com
