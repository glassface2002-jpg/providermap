# Normalize line endings so Windows/macOS/Linux contributors don't generate
# spurious whole-file diffs from CRLF vs LF.
* text=auto eol=lf

*.py text eol=lf diff=python
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Windows batch files need CRLF - Windows cmd.exe is picky about it.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary / generated - never diff, never merge.
*.db binary
*.xlsx binary
*.png binary
*.jpg binary

# Excel exports are generated output, not source - keep them out of GitHub's
# language statistics and diff view even in the rare case one gets committed
# by mistake.
exports/output/** linguist-generated=true
